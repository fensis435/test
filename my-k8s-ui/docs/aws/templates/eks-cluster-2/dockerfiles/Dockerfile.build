# =============================================================================
# Dockerfile.build - CodeBuild用ビルドコンテナイメージ
# ベース: Ubuntu 24.04 LTS
# 用途: Helm package / Docker image build / git操作
# =============================================================================
FROM ubuntu:24.04

ARG CODEARTIFACT_TOKEN
ARG CODEARTIFACT_DOMAIN
ARG CODEARTIFACT_REPO
ARG AWS_REGION=ap-northeast-1
ARG AWS_ACCOUNT_ID

# ---------------------------------------------------------------------------
# 環境変数
# ---------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=ja_JP.UTF-8 \
    LC_ALL=ja_JP.UTF-8 \
    TZ=Asia/Tokyo \
    HELM_VERSION=3.16.3 \
    KUBECTL_VERSION=1.31.0 \
    AWS_CLI_VERSION=2.19.0 \
    RUBY_VERSION=3.3.6 \
    NODE_VERSION=22 \
    PYTHON_VERSION=3.12 \
    DOCKER_BUILDKIT=1

# ---------------------------------------------------------------------------
# APT パッケージ (CodeArtifact/S3プロキシ経由は設定後)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基本ツール
    ca-certificates \
    curl \
    wget \
    gnupg \
    lsb-release \
    git \
    jq \
    unzip \
    zip \
    make \
    build-essential \
    pkg-config \
    libssl-dev \
    libffi-dev \
    libpq-dev \
    libgmp-dev \
    # 言語系
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    ruby-full \
    nodejs \
    npm \
    # Docker in Docker用
    docker.io \
    # 国際化
    locales \
    tzdata \
  && locale-gen ja_JP.UTF-8 \
  && ln -sf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime \
  && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# AWS CLI v2
# ---------------------------------------------------------------------------
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
      -o /tmp/awscliv2.zip \
  && unzip -q /tmp/awscliv2.zip -d /tmp \
  && /tmp/aws/install \
  && rm -rf /tmp/aws /tmp/awscliv2.zip \
  && aws --version

# ---------------------------------------------------------------------------
# kubectl
# ---------------------------------------------------------------------------
RUN curl -fsSL \
    "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    -o /usr/local/bin/kubectl \
  && chmod +x /usr/local/bin/kubectl \
  && kubectl version --client

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------
RUN curl -fsSL \
    "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
    -o /tmp/helm.tar.gz \
  && tar -zxvf /tmp/helm.tar.gz -C /tmp \
  && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
  && rm -rf /tmp/helm.tar.gz /tmp/linux-amd64 \
  && helm version

# ---------------------------------------------------------------------------
# helm-s3 プラグイン (S3をHelmリポジトリとして使用)
# ---------------------------------------------------------------------------
RUN helm plugin install https://github.com/hypnoglow/helm-s3.git --version 0.16.2

# ---------------------------------------------------------------------------
# eksctl
# ---------------------------------------------------------------------------
RUN curl -fsSL \
    "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_Linux_amd64.tar.gz" \
    -o /tmp/eksctl.tar.gz \
  && tar -zxvf /tmp/eksctl.tar.gz -C /tmp \
  && mv /tmp/eksctl /usr/local/bin/eksctl \
  && rm /tmp/eksctl.tar.gz

# ---------------------------------------------------------------------------
# CodeArtifact 設定後の pip / gem / npm インストール
# ---------------------------------------------------------------------------
# pip を CodeArtifact に向ける (ビルド引数がある場合のみ)
RUN if [ -n "${CODEARTIFACT_TOKEN}" ] && [ -n "${CODEARTIFACT_DOMAIN}" ]; then \
      PYPI_ENDPOINT="https://${CODEARTIFACT_DOMAIN}-${AWS_ACCOUNT_ID}.d.codeartifact.${AWS_REGION}.amazonaws.com/pypi/${CODEARTIFACT_REPO}/simple/" && \
      pip3 config set global.index-url \
        "https://aws:${CODEARTIFACT_TOKEN}@${PYPI_ENDPOINT#https://}" && \
      pip3 install --no-cache-dir \
        awscli-local \
        boto3 \
        pyyaml \
        jinja2 \
        requests; \
    else \
      pip3 install --no-cache-dir \
        boto3 \
        pyyaml \
        jinja2 \
        requests; \
    fi

# Bundler インストール (Rails用)
RUN gem install bundler -v 2.5.23 --no-document

# ---------------------------------------------------------------------------
# ビルドスクリプト
# ---------------------------------------------------------------------------
COPY scripts/build-entrypoint.sh /usr/local/bin/build-entrypoint.sh
RUN chmod +x /usr/local/bin/build-entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/build-entrypoint.sh"]
CMD ["bash"]
