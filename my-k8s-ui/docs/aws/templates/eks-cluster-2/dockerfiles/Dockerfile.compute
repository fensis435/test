# =============================================================================
# Dockerfile.compute - 計算用Podコンテナ
# ベース: AlmaLinux 9
# 機能: 科学計算 / データ処理 / Python + 各種ライブラリ
# Karpenterで動的起動されるPod用
# =============================================================================

# ---- ビルドステージ ----
FROM almalinux:9 AS builder

ARG CODEARTIFACT_TOKEN
ARG CODEARTIFACT_DOMAIN
ARG AWS_REGION=ap-northeast-1
ARG AWS_ACCOUNT_ID
ARG PYTHON_VERSION=3.12

ENV LANG=ja_JP.UTF-8 \
    TZ=Asia/Tokyo \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN dnf update -y && dnf install -y \
    python3 \
    python3-pip \
    python3-devel \
    gcc \
    gcc-c++ \
    make \
    git \
    curl \
    libpq-devel \
    openssl-devel \
    blas-devel \
    lapack-devel \
    openblas-devel \
    glibc-langpack-ja \
  && dnf clean all \
  && localedef -f UTF-8 -i ja_JP ja_JP.UTF-8

WORKDIR /app

# pip を CodeArtifact に向ける (引数がある場合)
RUN if [ -n "${CODEARTIFACT_TOKEN}" ] && [ -n "${CODEARTIFACT_DOMAIN}" ]; then \
      PYPI_ENDPOINT="https://${CODEARTIFACT_DOMAIN}-${AWS_ACCOUNT_ID}.d.codeartifact.${AWS_REGION}.amazonaws.com/pypi/${CODEARTIFACT_DOMAIN}/simple/" && \
      pip3 config set global.index-url \
        "https://aws:${CODEARTIFACT_TOKEN}@${PYPI_ENDPOINT#https://}"; \
    fi

COPY requirements.txt ./
RUN pip3 install --no-cache-dir --user -r requirements.txt

# ---- 本番実行ステージ ----
FROM almalinux:9 AS production

ENV LANG=ja_JP.UTF-8 \
    TZ=Asia/Tokyo \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/compute/.local/bin:${PATH}"

RUN dnf update -y && dnf install -y \
    python3 \
    libpq \
    openssl \
    openblas \
    curl \
    aws-cli \
    glibc-langpack-ja \
  && dnf clean all \
  && localedef -f UTF-8 -i ja_JP ja_JP.UTF-8

RUN groupadd -g 1001 compute && useradd -u 1001 -g compute -m compute

WORKDIR /app

COPY --from=builder --chown=compute:compute /root/.local /home/compute/.local
COPY --chown=compute:compute . .

RUN mkdir -p /data/input /data/output /data/tmp \
  && chown -R compute:compute /data

USER compute

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import sys; sys.exit(0)"

ENTRYPOINT ["python3"]
CMD ["worker.py"]
