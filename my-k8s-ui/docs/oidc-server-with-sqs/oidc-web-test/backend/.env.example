OIDC_ISSUER=https://idp.dev.test
FRONTEND_ORIGIN=https://app.dev.test
PORT=3001
RAILS_ENV=development

# --- Cognito -> SQS -> Backend 同期パイプライン(bin/sqs_poller用) ---
# oidc-dev-server側の docker compose up elasticmq が起動している前提。
SQS_QUEUE_URL=http://127.0.0.1:9324/queue/cognito-user-events
SQS_ENDPOINT=http://127.0.0.1:9324
AWS_REGION=ap-northeast-1
# ElasticMQは署名検証を行わないため、値は何でもよい(ダミー)。
# 実AWSに向ける場合はこれらを設定せず、IAMロール等に解決させること。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
