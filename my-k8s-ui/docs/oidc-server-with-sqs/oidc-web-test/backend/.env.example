OIDC_ISSUER=https://idp.dev.test
FRONTEND_ORIGIN=https://app.dev.test
PORT=3001
RAILS_ENV=development

# --- Cognito -> SQS -> Backend 同期パイプライン(bin/sqs_poller用) ---
# oidc-dev-server側の docker compose up elasticmq が起動している前提。
SQS_QUEUE_URL=http://localhost:9324/queue/cognito-user-events
SQS_ENDPOINT=http://localhost:9324
AWS_REGION=ap-northeast-1
# ElasticMQは署名検証を行わないため、値は何でもよい(ダミー)。
# 実AWSに向ける場合はこれらを設定せず、IAMロール等に解決させること。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- 定期リコンサイル(bin/reconciler用) ---
# SQS通知の取りこぼしを補正するため、oidc-dev-serverの全ユーザー一覧を
# 定期的に取得して突き合わせる。oidc-dev-server側で作成済みの管理者
# アカウント(SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD)を指定する。
RECONCILE_ADMIN_EMAIL=admin@example.com
RECONCILE_ADMIN_PASSWORD=change-me-please
# リコンサイルの実行間隔(秒)。既定は5分。
RECONCILE_INTERVAL_SECONDS=300
