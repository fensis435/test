# --- General ---
NODE_ENV=development
PORT=3000

# --- OIDC Core ---
# Discovery documentのissuerとして公開される値。
# Cognito移行時はここをCognito User Pool issuer URLに切り替えるだけでよい設計。
OIDC_ISSUER=https://idp.dev.test

# リバースプロキシ(Caddy/nginx/ALB等)配下で動作させる場合は "true" にする。
# localhostへの直接httpアクセスで開発している場合は "false"(既定値)のままでよい。
# 本番(EKS + ALB Ingress)では必ず "true" にすること
# (Cookie の Secure 属性や protocol 判定が正しく機能しなくなるため)。
OIDC_TRUST_PROXY=true

# oidc-provider cookie署名鍵(カンマ区切りで複数指定可、ローテーション用)
OIDC_COOKIE_KEYS=(dev-cookie-secret-key-please-change)

# JWKS用秘密鍵の保存先(K8s SecretやKMSと連携する想定。開発時はファイルパス)
OIDC_JWKS_PATH=./secrets/jwks.json

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Admin Management API ---
# 人間の管理者ログイン(/api/v1/auth/login)発行トークンの署名鍵
ADMIN_JWT_SECRET=(dev-admin-jwt-secret-please-change)
ADMIN_JWT_TTL_SECONDS=3600

# --- Webhook ---
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=2000

# --- Cognito -> SQS -> Backend 同期パイプラインのシミュレーション(任意) ---
# 未設定(コメントアウトのまま)ならこの機能自体が無効化される。
# docker compose up elasticmq 済みであれば、下記のコメントを外すだけで有効化できる。
SQS_QUEUE_URL=http://elasticmq:9324/queue/cognito-user-events
SQS_ENDPOINT=http://elasticmq:9324
AWS_REGION=ap-northeast-1
# ElasticMQは署名検証を行わないため、値は何でもよい(ダミー)。
# 実AWSに向ける場合はこれらを設定せず、IAMロール等に解決させること。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
