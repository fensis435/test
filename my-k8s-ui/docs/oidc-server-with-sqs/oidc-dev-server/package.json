{
  "name": "oidc-dev-server",
  "version": "1.0.0",
  "description": "Development OIDC Provider (standard OIDC compliant) - replacement target for AWS Cognito Hosted UI",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "generate:jwks": "tsx scripts/generate-jwks.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1107.0",
    "@prisma/client": "5.20.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.6",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jose": "5.9.3",
    "nanoid": "5.0.7",
    "oidc-provider": "8.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "22.5.5",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "is-generator-function": "1.0.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
