# syntax=docker/dockerfile:1

########################################
# Stage 1: build (pyenv/python-buildでPython本体を構築)
########################################
#Separeted into Dockerfile.build-base

########################################
# Stage 2: deps (pip installはbuildステージ上で実行)
########################################
FROM build-base:ruby3.3.5-python3.12.4 AS deps

WORKDIR /app
COPY python-app/requirements.txt ./

RUN /opt/python/bin/python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN pip install --no-cache-dir -r requirements.txt

COPY python-app/ .

RUN mkdir -p /tmp/deps && \
    { \
      find /opt/python /opt/venv -type f \( -name "*.so*" -o -perm -u+x \) 2>/dev/null ; \
    } | sort -u | xargs -I{} sh -c 'ldd "{}" 2>/dev/null' \
      | awk '/=>/{print $3} !/=>/{print $1}' \
      | grep '^/' | sort -u > /tmp/deps/shared_libs.txt || true

########################################
# Stage 3: runtime (最小イメージ + 実行に必要なものだけコピー)
########################################
FROM almalinux:9-minimal AS runtime

RUN microdnf install -y --setopt=install_weak_deps=0 \
        openssl-libs readline zlib libyaml libffi \
        bzip2-libs ncurses-libs sqlite-libs xz-libs \
        ca-certificates tzdata shadow-utils \
        which iputils procps-ng net-tools wget \
        tar gzip unzip vim-enhanced findutils psmisc \
    && microdnf clean all

COPY --from=deps /opt/python /opt/python
COPY --from=deps /opt/venv /opt/venv
COPY --from=deps /app /app

RUN echo "/opt/python/lib" > /etc/ld.so.conf.d/python.conf \
    && ldconfig

ENV PATH="/opt/venv/bin:/opt/python/bin:${PATH}"

RUN groupadd -g 10001 appgroup \
    && useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser \
    && chown -R appuser:appgroup /app /tmp
USER appuser
WORKDIR /app

EXPOSE 5000

CMD ["gunicorn", "-b", "0.0.0.0:5000", "app:app"]
