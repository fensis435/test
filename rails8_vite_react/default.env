# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Application Configuration
VITE_APP_NAME=User Management System
VITE_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# Kubernetes Controller Configuration
export HELM_CHART_PATH="./helm-charts/user-app"
export HELM_CHART_NAME="user-app"
export HELM_VALUES_FILE="./helm-charts/user-app/values.yaml"
export APP_IMAGE_TAG="latest"
export APP_BASE_DOMAIN="apps.yourdomain.com"
export SESSION_TIMEOUT_MINUTES="30"
export AUTO_DEPLOY_USER_APPS="true"

# Optional: Analytics, Logging, etc.
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn
